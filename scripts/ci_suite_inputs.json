{
  "version": 1,
  "description": "Inputs of the heavy Docs Checks suites. A same-repository pull request skips a suite only when no file matched by shared_inputs or by the suite's inputs differs between the trusted base checkout and the pull-request head. Main pushes, the nightly run, manual dispatches and fork pull requests run every suite. Patterns are repository-relative POSIX paths: a plain path names one file, a trailing /** names a directory tree, and *, ? and [] are shell-style wildcards that may also match a slash. The lists were derived by tracing every file each suite opens, lists or globs while it runs (Python audit hooks, child processes included), then widened to whole directories where a suite enumerates them.",
  "shared_inputs": [
    "scripts/**",
    "requirements-ci.txt",
    ".github/workflows/**",
    ".gitattributes",
    "conftest.py",
    "tests/conftest.py",
    "tests/__init__.py",
    "pytest.ini",
    "pyproject.toml",
    "setup.cfg",
    "tox.ini"
  ],
  "suites": {
    "adversarial_runtime_report": {
      "inputs": [
        "tests/test_adversarial_runtime_report_v1.py",
        "scripts/validate_adversarial_runtime_report_v1.py",
        "docs/platform/**"
      ]
    },
    "graphql_face_provenance": {
      "inputs": [
        "tests/test_graphql_face_provenance_checker.py",
        "scripts/check_graphql_face_provenance.py",
        "api/graphql.md",
        "api/mcp.md"
      ]
    },
    "semantic_operation_route": {
      "inputs": [
        "tests/test_semantic_operation_route_contract.py",
        "tests/semantic_operation_route_contract.json",
        "api/semantic-operation-route.md",
        "scripts/ci_local.sh"
      ]
    },
    "portal_ux": {
      "inputs": [
        "tests/test_portal_ux_contract_checker.py",
        "scripts/check_portal_ux_contract.py",
        "api/portal.md"
      ]
    },
    "msp_docs_clean": {
      "inputs": [
        "tests/test_platform_contracts.py",
        "tests/test_synchronized_evidence_contract.py",
        "tests/test_synchronized_evidence_executable_contract.py",
        "tests/test_synchronized_evidence_one_shot_contract.py",
        "tests/test_candidate_fact_graph_contract.py",
        "tests/test_candidate_fact_graph_executable_contract.py",
        "tests/test_multi_runtime_live_coexistence_contract.py",
        "tests/test_leaf_promotion_dossier_contract.py",
        "tests/test_captured_multi_leaf_promotion_contract.py",
        "tests/test_msp085_live_completion.py",
        "tests/test_msp085_final_18_leaf_completion.py",
        "scripts/generate_captured_multi_leaf_promotion_fixture.py",
        "scripts/generate_multi_runtime_coexistence_fixture.py",
        "scripts/platform_publication_token.py",
        "scripts/project_candidate_fact_public_status.py",
        "scripts/validate_candidate_fact_graph.py",
        "scripts/validate_captured_multi_leaf_promotion.py",
        "scripts/validate_leaf_promotion_dossier.py",
        "scripts/validate_multi_runtime_coexistence.py",
        "scripts/validate_platform_combined_ref.py",
        "scripts/validate_platform_contracts.py",
        "scripts/validate_synchronized_evidence.py",
        "scripts/ci_local.sh",
        "requirements-ci.txt",
        ".github/workflows/docs-ci.yml",
        ".github/workflows/platform-contracts-combined-ref.yml",
        "Makefile",
        "docs/platform/**"
      ]
    },
    "modbus_companion": {
      "inputs": [
        "tests/test_canonical_pv_semantics_v1.py",
        "tests/test_public_graphql_m2m_v1.py",
        "tests/test_eebus_operator_admin_contract.py",
        "tests/test_driver_runtime_manager_v1.py",
        "tests/test_runtime_driver_registration.py",
        "tests/test_bidirectional_registration.py",
        "tests/test_runtime_driver_registration_rendered.py",
        "scripts/bidirectional_registration_contract.json",
        "scripts/check_bidirectional_registration.py",
        "scripts/check_runtime_driver_registration.py",
        "scripts/validate_canonical_pv_v1.py",
        "scripts/validate_modbus_companion.py",
        "scripts/validate_platform_contracts.py",
        "scripts/validate_public_graphql_m2m_v1.py",
        "scripts/ci_local.sh",
        "README.md",
        "api/driver-runtime-v1.md",
        "api/graphql.md",
        "api/mcp.md",
        "api/portal.md",
        "api/public-graphql-m2m-v1.graphql",
        "api/public-graphql-m2m-v1.query.graphql",
        "architecture/bidirectional-driver-registration.md",
        "architecture/runtime-driver-lifecycle.md",
        "docs/platform/**"
      ]
    }
  }
}
